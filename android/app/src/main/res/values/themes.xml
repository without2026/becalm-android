<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base app theme. Extends Material3 DayNight with no action bar.
        Status/navigation bars are transparent so Compose edge-to-edge can
        manage them via WindowInsets.
    -->
    <style name="Theme.Becalm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
        Splash theme: extends base theme with the same warm canvas used by the
        canonical Compose theme. The activity transitions to the real Compose
        theme once onCreate completes.
    -->
    <style name="Theme.Becalm.Splash" parent="Theme.Becalm">
        <!-- API ≤ 30 fallback: without this the window flashes white before first frame. -->
        <item name="android:windowBackground">#F4F0E9</item>
        <!-- API 31+: Android 12 splash screen background colour. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#F4F0E9</item>
    </style>

</resources>
